       "sql": "WITH g AS (SELECT TIMESTAMP '2026-09-09 22:00:00' + INTERVAL 15 MINUTE * i AS ts FROM range(96) t(i))\nSELECT strftime(g.ts + INTERVAL 2 HOUR, '%Y-%m-%dT%H:%M:%S') || '+02:00' AS bucket_start, SUM(r.kwh) AS value\nFROM g LEFT JOIN reading r ON r.meter_id='mach_b2_2' AND r.ts_utc=g.ts\nGROUP BY g.ts ORDER BY g.ts"
