      "input": {
       "sql": "WITH g AS (SELECT strftime(TIMESTAMP '2026-09-10 00:00:00' + i * INTERVAL 15 MINUTE, '%Y-%m-%dT%H:%M:%S') || '+02:00' AS bucket_start FROM range(96) t(i))\nSELECT g.bucket_start, r.v AS value FROM g LEFT JOIN (SELECT local_start, sum(kwh) v FROM reading WHERE meter_id='mach_b2_2' AND local_date='2026-09-10' GROUP BY local_start) r ON r.local_start=g.bucket_start ORDER BY g.bucket_start"
